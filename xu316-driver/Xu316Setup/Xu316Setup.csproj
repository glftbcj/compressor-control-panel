<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>Xu316Setup</RootNamespace>
    <AssemblyName>Xu316Setup</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Description>XMOS XU316 USB Audio Windows Setup Bootstrapper</Description>
    <Version>1.0.0</Version>
    <Copyright>MIT License</Copyright>
    <!-- Single-file self-contained publish settings (used by CI) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI access for USB device enumeration on Windows -->
    <PackageReference Include="System.Management" Version="9.0.4" />
  </ItemGroup>

</Project>
