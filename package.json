{
  "name": "hvacr-control",
  "version": "1.0.0",
  "private": true,
  "description": "Native-feeling HVACR controller powered by .NET 10, MQTT and WebView2",
  "scripts": {
    "start": "dotnet run --project src/Hvacr.Server/Hvacr.Server.csproj",
    "dev": "dotnet watch --project src/Hvacr.Server/Hvacr.Server.csproj run",
    "build": "dotnet build Hvacr.slnx",
    "desktop": "dotnet run --project desktop/Hvacr.Desktop/Hvacr.Desktop.csproj",
    "desktop:publish": "dotnet publish desktop/Hvacr.Desktop/Hvacr.Desktop.csproj -c Release -r win-x64 /p:PublishSingleFile=true /p:SelfContained=true /p:IncludeNativeLibrariesForSelfExtract=true /p:EnableCompressionInSingleFile=true /p:DebugType=None /p:DebugSymbols=false"
  },
  "license": "MIT"
}
